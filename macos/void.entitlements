<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Strict Apple App Sandbox. Every macOS VOID app is signed with this. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Powerbox. A folder only becomes visible to the app after the person
	     picks it in an NSOpenPanel; the sandbox extension lives for the
	     process, which is exactly how long a VOID folder grant lives. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Required. A sandboxed process cannot reach gemini.google.com, or any
	     wrapped site, without the network client entitlement. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Keep the wrapper's existing capabilities working under the sandbox. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
